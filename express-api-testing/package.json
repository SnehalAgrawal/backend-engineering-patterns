{
  "name": "express-api-testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An Express and MongoDB API with integration tests against a real MongoDB, error handling, coverage, and CI.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "mongoose": "9.11.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "chai": "6.3.0",
    "chai-http": "5.2.1",
    "mocha": "12.0.3",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.38"
    }
  }
}
